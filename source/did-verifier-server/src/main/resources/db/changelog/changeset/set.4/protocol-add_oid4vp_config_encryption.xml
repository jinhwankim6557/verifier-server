<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <!-- OID4VP JWE 응답 암호화: 기존 oid4vp_config seed row에 encryption(alg/enc) 필드만 백필한다.
         이미 encryption 키가 있는 row(관리자가 이미 편집한 경우 등)는 건드리지 않는다.
         주의(최종 리뷰 반영): 이전 버전은 config 컬럼 전체를 하드코딩 리터럴로 <update>했었는데,
         그러면 encryption 키가 없다는 이유만으로 baseUrl/clientId/vpTokenEncryptionKey 등
         운영자가 이미 커스터마이징한 다른 모든 필드까지 기본값으로 덮어써버리는 데이터 유실 버그였다.
         jsonb 병합(||)으로 encryption 키만 추가하고 나머지 필드는 현재 값을 그대로 보존한다. -->
    <changeSet id="oid4vp-config-add-encryption" author="unified-verifier">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">SELECT COUNT(*) FROM oid4vp_config WHERE type = 'OID4VP' AND config NOT LIKE '%"encryption"%'</sqlCheck>
        </preConditions>
        <sql>
            UPDATE oid4vp_config
            SET config = (config::jsonb || '{"encryption":{"alg":"ECDH-ES","enc":"A256GCM"}}'::jsonb)::text
            WHERE type = 'OID4VP';
        </sql>
    </changeSet>

</databaseChangeLog>
