<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <!-- Issuer가 SD-JWT를 dc+sd-jwt-did 포맷으로 추가 발급하기 시작함에 따라, Wallet에게 이 포맷도
         받는다고 광고하도록 client_metadata.vpFormatsSupported에 dc+sd-jwt-did를 추가한다.
         jsonb_set으로 그 한 키만 백필하고 baseUrl/crypto/기존 포맷 등 나머지 필드는 그대로 보존한다
         (oid4vp-config-add-encryption changeset과 동일한 이유 — 전체 config를 리터럴로 덮어쓰지 않음). -->
    <changeSet id="oid4vp-config-add-sdjwt-did-format" author="unified-verifier">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">SELECT COUNT(*) FROM oid4vp_config WHERE type = 'OID4VP' AND config NOT LIKE '%dc+sd-jwt-did%'</sqlCheck>
        </preConditions>
        <sql>
            UPDATE oid4vp_config
            SET config = jsonb_set(
                config::jsonb,
                '{clientMetadata,vpFormatsSupported,dc+sd-jwt-did}',
                '{}'::jsonb,
                true
            )::text
            WHERE type = 'OID4VP';
        </sql>
    </changeSet>

</databaseChangeLog>
